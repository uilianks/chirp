{
  "name": "chirp-game-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Game sound effects and music as code for AI agents and humans: synth SFX, chiptune songs, audio-sprite banks, spectrogram previews and a live listening viewer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chirp": "./bin/chirp.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "examples": "node scripts/examples.ts",
    "check": "npm run typecheck && npm test && npm run examples"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uilianks/chirp.git"
  },
  "homepage": "https://github.com/uilianks/chirp#readme",
  "keywords": [
    "game-audio",
    "sfx",
    "chiptune",
    "synthesizer",
    "sound-effects",
    "music",
    "dsl",
    "gamedev",
    "ai-agent",
    "claude-code",
    "skill"
  ]
}
